+static int h264e_fixed_qp_frame_start(struct h264e_ctx *ctx, struct h264e_frame_start_params *p)
+{
+	h264_pps_t *pps = &ctx->pps;
+	int i_nal_type, i_nal_ref_idc;
+	unsigned int sh_bits;
+	int qp;
+	bs_t bs;
+
+	if (!ctx->s) {
+		return -EINVAL;
+	}
+
+	if (p->bIFrmReq) {
+		i_nal_type = NAL_SLICE_IDR;
+		i_nal_ref_idc = NAL_PRIORITY_HIGHEST;
+		ctx->sh.i_type = M_SLICE_TYPE_I;
+		qp = ctx->p.i_qp;
+	} else {
+		i_nal_type = NAL_SLICE;
+		i_nal_ref_idc = NAL_PRIORITY_HIGH;
+		ctx->sh.i_type = M_SLICE_TYPE_P;
+		qp = ctx->p.p_qp;
+	}
+	qp = clamp(qp, 0, 51);
+
+	if (i_nal_type == NAL_SLICE_IDR) {
+		h264e_slice_header_init(&ctx->sh, &ctx->sps, pps, ctx->p.i_idr_pic_id, ctx->i_frame, qp);
+		ctx->p.i_idr_pic_id ^= 1;
+	} else {
+		h264e_slice_header_init(&ctx->sh, &ctx->sps, pps, -1, ctx->i_frame, qp);
+		ctx->sh.i_num_ref_idx_l0_active = 1;
+		ctx->sh.i_num_ref_idx_l1_active = 1;
+	}
+
+	/* NAL start code (the 0xFF is patched to 0x00 after encoding) and header */
+	bs_init(&bs, ctx->slice_header, MAX_SLICE_HEADER_SIZE);
+	bs_write(&bs, 8, 0x00);
+	bs_write(&bs, 8, 0xFF);
+	bs_write(&bs, 8, 0x00);
+	bs_write(&bs, 8, 0x01);
+	bs_write(&bs, 8, (0 << 7 | (i_nal_ref_idc << 5) | (i_nal_type)));
+
+	h264e_slice_header_write(&bs, &ctx->sh, i_nal_ref_idc);
+
+	if (pps->b_cabac) {
+		bs_align_1(&bs);
+		h264_cabac_context_init(&ctx->cb, ctx->sh.i_type, ctx->sh.i_qp, ctx->sh.i_cabac_init_idc);
+	}
+
+	sh_bits = bs_pos(&bs);
+	p->slice_header_len = (sh_bits + 7) / 8;
+
+	h264e_fixed_qp_fill_slice_info(ctx, p, ctx->sh.i_qp, sh_bits);
+
+	H264E_SliceInit(ctx->s);
+
+	return 0;
+}
