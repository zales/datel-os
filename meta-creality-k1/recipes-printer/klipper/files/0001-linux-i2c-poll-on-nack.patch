Linux host MCU: poll an I2C device that NACKs instead of shutting down

The BL24C16F EEPROM on the K1 is busy for up to 5 ms after a page write and
NACKs its address meanwhile. Creality's power-loss recovery writes it during
a print; with the 6.6 i2c driver the NACK surfaces as EIO and the host MCU
shut down the print ("MCU 'rpi' shutdown: Unable write i2c device").

--- a/src/linux/i2c.c	2026-11-07 15:16:01
+++ b/src/linux/i2c.c	2026-11-07 15:16:01
@@ -3,6 +3,7 @@
 // Copyright (C) 2020  Eric Callahan <arksine.code@gmail.com>
 //
 // This file may be distributed under the terms of the GNU GPLv3 license.
+#include <errno.h> // errno
 #include <fcntl.h> // open
 #include <linux/i2c-dev.h> // I2C_SLAVE
 #include <stdio.h> // snprintf
@@ -79,12 +80,24 @@
 void
 i2c_write(struct i2c_config config, uint8_t write_len, uint8_t *data)
 {
-    int ret = write(config.fd, data, write_len);
-    if (ret != write_len) {
-        if (ret < 0)
-            report_errno("write value i2c", ret);
-        try_shutdown("Unable write i2c device");
+    // An EEPROM (BL24C16F on the K1) does not ACK its address for up to
+    // 5ms after a page write.  The 6.6 i2c driver reports that as EIO, so
+    // poll the device for a while instead of shutting down at once.
+    int ret = -1, tries;
+    for (tries = 0; tries < 40; tries++) {
+        ret = write(config.fd, data, write_len);
+        if (ret == write_len)
+            return;
+        if (ret >= 0)
+            break;
+        if (errno != EIO && errno != ENXIO && errno != EREMOTEIO
+            && errno != EAGAIN && errno != ETIMEDOUT)
+            break;
+        usleep(500);
     }
+    if (ret < 0)
+        report_errno("write value i2c", ret);
+    try_shutdown("Unable write i2c device");
 }
 
 void
