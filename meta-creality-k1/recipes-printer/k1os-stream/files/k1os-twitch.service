[Unit]
Description=Twitch live stream of the camera with a status overlay
After=network-online.target ustreamer.service moonraker.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/libexec/k1os/twitch
Restart=on-failure
RestartSec=15
# The wrapper tears the pipeline down itself on SIGTERM: producers first, then
# up to 4 s for ffmpeg to close the RTMP session by itself, and exits 0. Only
# the wrapper gets the SIGTERM (mixed): one sent to ffmpeg too makes it drop
# the session instead of closing it. The timeout is only a backstop.
KillMode=mixed
TimeoutStopSec=10
SuccessExitStatus=143
# The key stays in twitch.env (root, 0600); nothing here or in the logs names it.
Nice=5
# Out of memory, the Twitch stream is the first to go.
OOMScoreAdjust=700

