[Unit]
Description=Twitch live stream of the camera with a status overlay
After=network-online.target k1os-camera.service moonraker.service
Requires=k1os-camera.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/libexec/k1os/twitch
Restart=on-failure
RestartSec=15
# On SIGTERM the wrapper asks k1os-camera to end the stream, waits until it
# has closed the RTMP session, and exits 0. The timeout is only a backstop.
KillMode=mixed
TimeoutStopSec=10
SuccessExitStatus=143
# The key stays in twitch.env (root, 0600); nothing here or in the logs names it.
Nice=5
# Out of memory, the Twitch stream is the first to go.
OOMScoreAdjust=700

