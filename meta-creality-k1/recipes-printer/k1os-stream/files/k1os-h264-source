#!/bin/sh
# go2rtc's source for the stream "k1" (/etc/go2rtc.yaml): camera frames (from
# uStreamer's memory sink, so the MJPEG camera stays; straight from the camera
# when uStreamer is not running), status overlay and H.264 by k1os-stream on
# the Helix codec, raw Annex B on stdout. go2rtc starts it while anyone
# watches (Mainsail's WebRTC player, the Twitch stream) and stops it with
# SIGTERM when the last one leaves.
#
# Twitch and the local view share this one encoder, so the picture follows
# the Twitch settings in /usr/data/k1os/twitch.env: TWITCH_BITRATE,
# TWITCH_FPS, TWITCH_OVERLAY, TWITCH_GRAPH_CORNER, and TWITCH_RESOLUTION
# without uStreamer. k1os-stream reports its rate to /run/k1os/stream-status.json.
TWITCH_BITRATE=; TWITCH_FPS=; TWITCH_RESOLUTION=; TWITCH_OVERLAY=; TWITCH_GRAPH_CORNER=
[ -r /usr/data/k1os/twitch.env ] && . /usr/data/k1os/twitch.env
TWITCH_KEY=
[ -r /usr/data/k1os/camera.env ] && . /usr/data/k1os/camera.env
FPS=${TWITCH_FPS:-${CAMERA_FPS:-8}}
BITRATE=${TWITCH_BITRATE:-2500}
SIZE=${TWITCH_RESOLUTION:-${CAMERA_RESOLUTION:-1280x720}}
STATUS=/run/k1os/stream-status.json
mkdir -p /run/k1os
OPTS="--fps $FPS --bitrate $BITRATE --status-file $STATUS"
case "${TWITCH_OVERLAY:-1}" in
    0) OPTS="$OPTS --no-overlay" ;;
    2) OPTS="$OPTS --graph ${TWITCH_GRAPH_CORNER:-tr}" ;;
esac

fifo=
dump=
if [ -e "/dev/shm/k1os::jpeg" ]; then
    # A FIFO instead of a pipe, so that both PIDs are known for the stop.
    fifo=/run/k1os/h264-source.$$
    rm -f "$fifo"
    mkfifo -m 600 "$fifo" || exit 1
    /usr/bin/ustreamer-dump --sink=k1os::jpeg --output - > "$fifo" 2>/dev/null &
    dump=$!
    /usr/bin/k1os-stream --camera - $OPTS < "$fifo" &
    enc=$!
else
    dev=$(/usr/libexec/k1os/camera-device) || exit 1
    /usr/bin/k1os-stream --camera "$dev" --size "$SIZE" $OPTS &
    enc=$!
fi

# ustreamer-dump does not always leave on SIGTERM while it waits for the sink.
cleanup() {
    kill -TERM $enc $dump 2>/dev/null
    n=0
    while [ $n -lt 20 ] && kill -0 $enc 2>/dev/null; do sleep 0.1; n=$((n + 1)); done
    kill -KILL $enc $dump 2>/dev/null
    [ -n "$fifo" ] && rm -f "$fifo"
    rm -f "$STATUS"
}
trap 'trap "" TERM INT; cleanup; exit 0' TERM INT
wait $enc
rc=$?
cleanup
exit $rc
