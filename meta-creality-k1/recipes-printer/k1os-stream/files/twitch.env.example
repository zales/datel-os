# Twitch live stream settings. Copy to /usr/data/k1os/twitch.env, mode 600:
#   umask 077; cp /etc/k1os/twitch.env.example /usr/data/k1os/twitch.env
# then put your stream key in (Twitch dashboard > Settings > Stream). The key
# stays in this file: nothing else on the printer reads it but the stream
# wrapper, and Mainsail's TWITCH dialog never shows it.
TWITCH_KEY=live_xxxxxxxx

# --- Lines below are also written by Mainsail's TWITCH dialog (TWITCH_SET) ---
# A closer ingest server (https://help.twitch.tv/s/twitch-ingest-recommendation),
# default rtmp://live.twitch.tv/app. The dialog's "EU" is live-prg, "US" live-iad.
#TWITCH_INGEST=rtmp://live-prg.twitch.tv/app
# Video bitrate in kbit/s; 2500 fits a 2.4 GHz Wi-Fi link at 720p.
#TWITCH_BITRATE=2500
# 1280x720 or 640x480. With uStreamer running (the normal case) the stream has
# the camera's resolution (CAMERA_RESOLUTION in camera.env); the value applies
# when k1os-stream captures the camera itself.
#TWITCH_RESOLUTION=1280x720
# Picture: 0 plain camera, 1 status bar, 2 status bar and the graph panel
# (20 minutes of nozzle and bed temperature, progress bar with remaining time).
#TWITCH_OVERLAY=1
# Corner of the graph panel: tl, tr (default), bl, br.
#TWITCH_GRAPH_CORNER=tr
# Frame rate of the stream; default: the camera's CAMERA_FPS from camera.env.
#TWITCH_FPS=15
# Start the stream at every boot.
#TWITCH_AUTOSTART=0

# --- Automatic stream title (Moonraker component k1os_stream) ---
# Client ID of a Twitch application (https://dev.twitch.tv/console/apps,
# category "Broadcaster Suite", client type "Public"). Not a secret. Then run
# TWITCH_LOGIN once in Mainsail; the tokens go to /usr/data/k1os/twitch-auth.json.
#TWITCH_CLIENT_ID=
# Your channel name; default: the login that TWITCH_LOGIN returned. Used for
# the "Twitch" player webcam in Mainsail.
#TWITCH_CHANNEL=
# Host names under which browsers open Mainsail, comma separated (the Twitch
# player only embeds into pages from these hosts); default: the printer's
# host name and <hostname>.local.
#TWITCH_PARENT=datel,datel.local
# Title template (Jinja). Placeholders: file, progress, elapsed, total_elapsed,
# hotend, bed (temperature/target with heating/cooling hint), hotend_temp,
# hotend_target, bed_temp, bed_target, state, state_emoji, layer, total_layers,
# channel, message. Twitch cuts titles at 140 characters.
#TWITCH_TITLE_TEMPLATE='🖨️ {{ file }} | 🚀 {{ progress }}% done | ⏰ {{ elapsed }} elapsed | 🔥 Hotend {{ hotend }} 🛏️ Bed {{ bed }} | {{ state_emoji }} {{ state }}'
# Title while no stream runs; default: leave the title as it is.
#TWITCH_IDLE_TITLE='Datel OS K1: offline'
# Category set when the stream starts; empty leaves it alone.
#TWITCH_CATEGORY='Makers & Crafting'
# Status line "Twitch: live 2.4 Mbit/s 00:12:31" on the printer display (M117,
# only while no other message is shown).
#TWITCH_M117=1
