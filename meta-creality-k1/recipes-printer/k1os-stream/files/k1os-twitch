#!/usr/bin/env python3
"""Live stream to Twitch (k1os-twitch.service): asks k1os-camera to publish
its H.264 picture, the one Mainsail's WebRTC camera shows, to Twitch's ingest
server over RTMP, and stays for as long as it does. A stop (SIGTERM) ends the
stream; k1os-camera then tells Twitch so, and the channel goes offline at once.

Settings in /usr/data/k1os/twitch.env (mode 600, the stream key lives only
there):
  TWITCH_KEY=live_...                      required
  TWITCH_INGEST=rtmp://live.twitch.tv/app  optional, a closer ingest server
  TWITCH_BITRATE=2500                      optional, kbit/s
  TWITCH_FPS=                              optional, default: the camera's CAMERA_FPS
  TWITCH_OVERLAY=1                         optional, 0 plain camera, 1 status bar,
                                           2 status bar and the graph panel
  TWITCH_GRAPH_CORNER=tr                   optional, corner of the panel: tl tr bl br
The picture settings are read by k1os-camera (/usr/libexec/k1os/camera-options)
when its encoder starts. Mainsail's TWITCH dialog (Moonraker component
k1os_stream) writes the optional lines."""
import json, os, signal, sys, time, urllib.request

ENV = "/usr/data/k1os/twitch.env"
STATUS = "/run/k1os/twitch-status.json"
CAMERA = "http://127.0.0.1:8080"


def read_env(path):
    """KEY=value lines as a shell would read them, quotes removed."""
    values = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
                value = value[1:-1]
            values[key.strip()] = value
    return values


def camera(path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(CAMERA + path, data=data, method="POST" if data is not None else "GET")
    with urllib.request.urlopen(request, timeout=5) as response:
        return response.read()


def publishing():
    return json.loads(camera("/status")).get("publish", "off")


def main():
    try:
        env = read_env(ENV)
    except OSError:
        print("k1os-twitch: %s is missing. Create it on the printer with your stream key:\n"
              "  umask 077; echo TWITCH_KEY=live_xxxxxxxx > %s" % (ENV, ENV), file=sys.stderr)
        return 1
    if not env.get("TWITCH_KEY"):
        print("k1os-twitch: TWITCH_KEY is empty in %s" % ENV, file=sys.stderr)
        return 1
    ingest = env.get("TWITCH_INGEST") or "rtmp://live.twitch.tv/app"

    stop = []
    signal.signal(signal.SIGTERM, lambda *_: stop.append(1))
    signal.signal(signal.SIGINT, lambda *_: stop.append(1))
    # The key goes in the request's body, to this machine only; nothing here
    # or in k1os-camera prints it.
    try:
        camera("/publish", {"url": ingest, "key": env["TWITCH_KEY"]})
    except Exception as e:
        print("k1os-twitch: k1os-camera did not take the stream: %s" % type(e).__name__, file=sys.stderr)
        return 1
    os.makedirs(os.path.dirname(STATUS), exist_ok=True)
    with open(STATUS, "w") as f:
        json.dump({"started": int(time.time())}, f)
    print("k1os-twitch: publishing to %s" % ingest, flush=True)

    rc, last = 0, None
    while not stop:
        time.sleep(1)
        try:
            state = publishing()
        except Exception:
            state = "off"       # k1os-camera is gone or restarting
        if state != last:
            print("k1os-twitch: %s" % state, flush=True)
            last = state
        if state == "off" and not stop:
            # Not our stop: fail, so that systemd starts the stream again
            # (Restart=on-failure). While "waiting", k1os-camera reconnects
            # by itself.
            rc = 1
            break
    try:
        camera("/unpublish", {})
        for _ in range(20):
            if publishing() == "off":
                break
            time.sleep(0.2)
    except Exception:
        pass
    try:
        os.unlink(STATUS)
    except OSError:
        pass
    return rc


if __name__ == "__main__":
    sys.exit(main())
