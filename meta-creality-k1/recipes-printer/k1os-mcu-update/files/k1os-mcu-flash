#!/usr/bin/env python3
"""Talk to the serial bootloader of the Creality K1 MCUs (GD32 boards).

Written from the observed protocol (also used by Creality's own updater):
  * the running Klipper firmware (230400 baud) reboots into the bootloader
    when it receives the string " \\x1c Request Serial Bootloader!! ~";
  * the bootloader (115200 baud) waits about 15 s after power-on for a
    handshake, then starts the application if its CRC16 is good;
  * every request is <command><crc>, every reply <data...><crc>, where
    crc = (sum of bytes mod 256) xor 0xff;
  * commands: 0x75 handshake (ack 0x75), 0x00 version (25 bytes:
    "<hw>-<fw>", e.g. mcu0_120_G32-mcu0_021_000), 0x03 sector size in KiB,
    0x01 update (then 4-byte LE size, then size-KiB chunks, each followed
    by its crc; replies 0x75 chunk ok, 0x20 done, 0x21 flash error,
    0x1f bad crc), 0x02 start the application.

Usage:
  k1os-mcu-flash PORT version             print the MCU's version string
  k1os-mcu-flash PORT update FILE.bin     flash FILE and start it
  k1os-mcu-flash PORT start               start the application
Exit code 0 on success, 1 on a protocol or I/O failure.
"""
import os, sys, time
import serial

MAGIC = b" \x1c Request Serial Bootloader!! ~"


def crc(data):
    return (sum(data) & 0xff) ^ 0xff


def log(msg):
    print("k1os-mcu-flash: " + msg, flush=True)


class Bootloader:
    def __init__(self, port):
        self.port = port
        self.ser = None

    def open(self, baud):
        self.close()
        self.ser = serial.Serial(self.port, baudrate=baud, timeout=2.0)

    def close(self):
        if self.ser is not None:
            self.ser.close()
            self.ser = None

    def request(self, cmd, reply_len, tries=3):
        for _ in range(tries):
            self.ser.reset_input_buffer()
            self.ser.write(bytes([cmd, crc(bytes([cmd]))]))
            r = self.ser.read(reply_len)
            if len(r) == reply_len and r[-1] == crc(r[:-1]):
                return r[:-1]
            time.sleep(0.2)
        return None

    def handshake(self, tries=5):
        for _ in range(tries):
            if self.request(0x75, 2, tries=1) == b"\x75":
                return True
            time.sleep(1)
        return False

    def enter_from_app(self):
        """Ask a running Klipper firmware to reboot into the bootloader."""
        self.open(230400)
        self.ser.write(MAGIC)
        self.ser.flush()
        self.close()
        time.sleep(1)

    def connect(self):
        """Reach the bootloader: either it is waiting after power-on, or the
        application is running and is asked to reboot into it."""
        self.open(115200)
        if self.handshake(tries=2):
            return True
        self.enter_from_app()
        self.open(115200)
        return self.handshake(tries=5)

    def version(self):
        r = self.request(0x00, 26)
        if r is None:
            return None
        return r.rstrip(b"\x00").decode("ascii", "replace")

    def sector_kib(self):
        r = self.request(0x03, 2)
        return r[0] if r else None

    def start_app(self):
        return self.request(0x02, 2) == b"\x75"

    def update(self, path):
        data = open(path, "rb").read()
        kib = self.sector_kib()
        if not kib:
            log("no sector size")
            return False
        chunk = kib * 1024
        if self.request(0x01, 2) != b"\x75":
            log("update request refused")
            return False
        size = len(data).to_bytes(4, "little")
        self.ser.write(size + bytes([crc(size)]))
        r = self.ser.read(2)
        if len(r) != 2 or r[0] != 0x75 or r[1] != crc(r[:1]):
            log("size refused: %s" % r.hex())
            return False
        sent = 0
        while sent < len(data):
            part = data[sent:sent + chunk]
            self.ser.write(part + bytes([crc(part)]))
            r = self.ser.read(2)
            if len(r) != 2 or r[1] != crc(r[:1]):
                log("no reply after %d bytes" % sent)
                return False
            sent += len(part)
            if r[0] == 0x75:
                continue
            if r[0] == 0x20:
                break
            log({0x21: "flash write error", 0x1f: "bad crc"}.get(r[0], "status 0x%02x" % r[0]))
            return False
        log("flashed %d bytes" % sent)
        return True


def firmware_header(path):
    """The 12-byte version string at offset 0x200, e.g. mcu0_021_000."""
    with open(path, "rb") as f:
        f.seek(0x200)
        return f.read(12).decode("ascii", "replace")


def main(argv):
    if len(argv) < 3:
        print(__doc__)
        return 2
    port, cmd = argv[1], argv[2]
    bl = Bootloader(port)
    try:
        if not bl.connect():
            log("%s: no bootloader handshake" % port)
            return 1
        if cmd == "version":
            v = bl.version()
            if v is None:
                return 1
            print(v)
            return 0
        if cmd == "start":
            return 0 if bl.start_app() else 1
        if cmd == "update":
            path = argv[3]
            hdr = firmware_header(path)
            if hdr[:4] not in ("mcu0", "noz0", "bed0") or hdr[4] != "_" or hdr[8] != "_":
                log("%s has no Creality firmware header (%r)" % (path, hdr))
                return 1
            cur = bl.version()
            log("%s: current %s, file %s" % (port, cur, os.path.basename(path)))
            if cur and cur[:4] != hdr[:4]:
                log("board type mismatch, refusing")
                return 1
            ok = bl.update(path)
            started = bl.start_app()
            log("start application: %s" % ("ok" if started else "FAILED"))
            return 0 if ok and started else 1
        print(__doc__)
        return 2
    finally:
        bl.close()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
