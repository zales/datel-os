# Mainsail on port 80, Moonraker API proxied from 127.0.0.1:7125
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# WebKit (Safari, OrcaSlicer's Device tab on macOS) fails a fetch() of a
# multipart/x-mixed-replace body with "Load failed", and Mainsail's MJPEG
# worker reads the stream with fetch(). The worker splits frames itself, so its
# request (a plain "Accept: */*" plus the ?timestamp= it appends) gets the same
# bytes labelled multipart/mixed; an <img>, a browser tab or any other client
# still gets multipart/x-mixed-replace. Sec-Fetch-Dest would be the cleaner
# test, but browsers send it only to HTTPS and localhost, not to the printer.
map "$http_accept|$arg_timestamp|$upstream_http_content_type" $webcam_content_type {
    "~^\*/\*\|\d+\|multipart/x-mixed-replace(?<ct_params>.*)$" "multipart/mixed$ct_params";
    default $upstream_http_content_type;
}

# Viewer limits. An MJPEG viewer costs the 2.4 GHz link about 6 Mbit/s, so only
# two streams are let in at a time; snapshots (?action=snapshot, the timelapse
# too) have an empty key and are not counted. A viewer over the limit gets 503
# and Mainsail's player tries again by itself until a place is free. WebRTC
# viewers (2.5 Mbit/s each) are counted by k1os-camera itself, which has four
# places.
map $arg_action $mjpeg_viewer_key {
    stream  $server_name;
    default "";
}
limit_conn_zone $mjpeg_viewer_key zone=mjpeg_viewers:64k;
limit_conn_status 503;

upstream apiserver {
    ip_hash;
    server 127.0.0.1:7125;
}

server {
    listen 80 default_server;

    root /usr/share/mainsail;
    index index.html;
    server_name _;

    client_max_body_size 0;
    proxy_request_buffering off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /websocket {
        proxy_pass http://apiserver/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location ~ ^/(printer|api|access|machine|server)/ {
        proxy_pass http://apiserver$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Scheme $scheme;
    }

    # Slicers set to the "Creality" host type post the file to /upload/<name>
    # (the stock web server's API) as a multipart "file" field, which is what
    # Moonraker's upload takes too; the name comes from the part itself.
    location /upload/ {
        rewrite ^/upload/.*$ /server/files/upload break;
        proxy_pass http://apiserver;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Camera: k1os-camera on 127.0.0.1:8080 (k1os-camera.service). MJPEG as
    # ?action=stream, a picture as ?action=snapshot, and WebRTC signalling as
    # POST /webcam/webrtc, where X-Real-IP tells it which of its addresses the
    # viewer can reach.
    location /webcam/ {
        limit_conn mjpeg_viewers 2;
        postpone_output 0;
        proxy_buffering off;
        proxy_ignore_headers X-Accel-Buffering;
        proxy_hide_header Content-Type;
        add_header Content-Type $webcam_content_type always;
        access_log off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8080/;
    }
}
