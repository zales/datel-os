# Mainsail on port 80, Moonraker API proxied from 127.0.0.1:7125
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# WebKit (Safari, OrcaSlicer's Device tab on macOS) fails a fetch() of a
# multipart/x-mixed-replace body with "Load failed", and Mainsail's MJPEG
# worker reads the stream with fetch(). The worker splits frames itself, so its
# request (a plain "Accept: */*" plus the ?timestamp= it appends) gets the same
# bytes labelled multipart/mixed; an <img>, a browser tab or any other client
# still gets multipart/x-mixed-replace. Sec-Fetch-Dest would be the cleaner
# test, but browsers send it only to HTTPS and localhost, not to the printer.
map "$http_accept|$arg_timestamp|$upstream_http_content_type" $webcam_content_type {
    "~^\*/\*\|\d+\|multipart/x-mixed-replace(?<ct_params>.*)$" "multipart/mixed$ct_params";
    default $upstream_http_content_type;
}

upstream apiserver {
    ip_hash;
    server 127.0.0.1:7125;
}

server {
    listen 80 default_server;

    root /usr/share/mainsail;
    index index.html;
    server_name _;

    client_max_body_size 0;
    proxy_request_buffering off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location /websocket {
        proxy_pass http://apiserver/websocket;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location ~ ^/(printer|api|access|machine|server)/ {
        proxy_pass http://apiserver$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Scheme $scheme;
    }

    # Slicers set to the "Creality" host type post the file to /upload/<name>
    # (the stock web server's API) as a multipart "file" field, which is what
    # Moonraker's upload takes too; the name comes from the part itself.
    location /upload/ {
        rewrite ^/upload/.*$ /server/files/upload break;
        proxy_pass http://apiserver;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Camera as H.264 over WebRTC: go2rtc on 127.0.0.1:1984 (go2rtc.service).
    # Mainsail's webrtc-go2rtc player only needs the signalling WebSocket; the
    # video then goes over UDP/TCP 8555. Only the stream "k1": go2rtc builds a
    # stream from any source URL in src=, an exec: one included.
    location = /go2rtc/api/ws {
        if ($arg_src != "k1") {
            return 403;
        }
        access_log off;
        proxy_pass http://127.0.0.1:1984;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_read_timeout 1d;
    }

    # Camera: uStreamer on 127.0.0.1:8080 (ustreamer.service)
    location /webcam/ {
        postpone_output 0;
        proxy_buffering off;
        proxy_ignore_headers X-Accel-Buffering;
        proxy_hide_header Content-Type;
        add_header Content-Type $webcam_content_type always;
        access_log off;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_pass http://127.0.0.1:8080/;
    }
}
