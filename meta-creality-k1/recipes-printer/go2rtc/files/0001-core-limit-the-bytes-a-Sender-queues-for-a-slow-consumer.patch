core: limit the bytes a Sender queues for a slow consumer

A Sender queues up to 4096 packets for a consumer whose codec is RTP video
(WebRTC). The number was chosen for RTP packets from an RTSP camera, about
a kilobyte each. From a producer that is not RTP (exec, pipe) the items are
whole frames, and nothing limits their size: the K1's camera gives 40 kB
frames at 2.5 Mbit/s, so one WebRTC viewer on a network slower than the
stream can make go2rtc hold 160 MB. The K1 has 216 MB of RAM and no swap.

Measured on the printer with Wi-Fi at -88 dBm: go2rtc went from 30 to
62 MB in five minutes, in the middle of a print. Reproduced with a
synthetic 2.5 Mbit/s stream, a second go2rtc as the WebRTC viewer and the
server's network limited to 1.5 Mbit/s (tc tbf): 35 -> 64 MB in three
minutes and rising. With this change it stops at 36 MB, the Sender counts
drops, and the memory comes back when the network does.

The queue now also has a limit in bytes (2 MiB, six seconds of the K1's
stream). A packet is always accepted into an empty queue, so a frame
larger than the limit still gets through.

Upstream-Status: Pending
---
diff --git a/pkg/core/track.go b/pkg/core/track.go
index f363a9f..e775616 100644
--- a/pkg/core/track.go
+++ b/pkg/core/track.go
@@ -3,6 +3,7 @@ package core
 import (
 	"encoding/json"
 	"errors"
+	"sync/atomic"
 
 	"github.com/pion/rtp"
 )
@@ -73,8 +74,17 @@ type Sender struct {
 
 	buf  chan *Packet
 	done chan struct{}
+
+	// bytes of payload waiting in buf
+	queued atomic.Int32
 }
 
+// maxQueuedBytes limits the payload a Sender holds for a consumer that
+// cannot keep up. The length of buf alone does not limit the memory: its
+// items are whole frames when the producer is not RTP (exec, pipe), and 4096
+// frames of a 2.5 Mbit/s camera are 160 MB.
+const maxQueuedBytes = 2 << 20
+
 func NewSender(media *Media, codec *Codec) *Sender {
 	var bufSize uint16
 
@@ -98,9 +108,17 @@ func NewSender(media *Media, codec *Codec) *Sender {
 	}
 	s.Input = func(packet *Packet) {
 		s.mu.Lock()
+		size := int32(len(packet.Payload))
+		if queued := s.queued.Load(); queued != 0 && queued+size > maxQueuedBytes {
+			// the consumer is too slow: drop, as with a full buf
+			s.Drops++
+			s.mu.Unlock()
+			return
+		}
 		// unblock write to nil chan - OK, write to closed chan - panic
 		select {
 		case s.buf <- packet:
+			s.queued.Add(size)
 			s.Bytes += len(packet.Payload)
 			s.Packets++
 		default:
@@ -142,6 +160,7 @@ func (s *Sender) Start() {
 	// pass buf directly so that it's impossible for buf to be nil
 	go func(buf chan *Packet) {
 		for packet := range buf {
+			s.queued.Add(-int32(len(packet.Payload)))
 			s.Output(packet)
 		}
 		close(s.done)
