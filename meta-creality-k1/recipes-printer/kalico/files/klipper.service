[Unit]
Description=Klipper 3D printer host (Creality K1)
Requires=k1os-datadir.service
Wants=klipper-mcu.service
After=k1os-datadir.service klipper-mcu.service network.target

[Service]
Type=simple
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/share/klipper/klippy/klippy.py \
    /usr/data/k1os/printer_data/config/printer.cfg \
    -l /usr/data/k1os/printer_data/logs/klippy.log \
    -a /tmp/klippy_uds
Restart=always
RestartSec=10
Nice=-10

[Install]
WantedBy=multi-user.target
