#!/usr/bin/env python3
"""Turn the Creality K1 Klipper configuration into one Kalico can load.

Runs once (marker file). The stock printer.cfg, gcode_macro.cfg and
sensorless.cfg are edited in place after a backup; k1os_kalico.cfg is
included for the load cell probe, bed mesh and shims.

Every start it also brings the saved load cell tare up to the form the
installed Kalico reads (one value per strain gauge).
"""
import os, re, shutil, sys

CFG = os.environ.get("K1OS_CONFIG_DIR", "/usr/data/k1os/printer_data/config")
MARK = os.path.join(CFG, ".k1os-kalico")
FRAG = os.environ.get("K1OS_KALICO_FRAGMENT", "/etc/k1os/k1os_kalico.cfg")

DROP_SECTIONS = {"prtouch_v2", "bl24c16f", "mcu rpi", "mcu leveling_mcu",
                 "custom_macro", "fan_feedback", "bed_mesh"}
DROP_SAVE_CONFIG_SECTIONS = ("bed_mesh ", "prtouch")
# Starting values for the SAVE_CONFIG block, measured on a K1 with Kalico. They
# go into the autosave block rather than k1os_kalico.cfg because Klipper refuses
# SAVE_CONFIG when an option exists in both; a later LOAD_CELL_CALIBRATE or
# shaper measurement simply overwrites them. Sections the stock block already
# has (Creality calibrates the shaper itself) are kept as they are.
SAVE_CONFIG_HEADER = (
    "#*# <---------------------- SAVE_CONFIG ---------------------->\n"
    "#*# DO NOT EDIT THIS BLOCK OR BELOW. The contents are auto-generated.\n"
    "#*#\n")
SEED_SAVE_CONFIG = {
    "input_shaper": (("shaper_type_x", "ei"), ("shaper_freq_x", "42.2"),
                     ("shaper_type_y", "mzv"), ("shaper_freq_y", "53.2")),
    # HX711 + Creality strain gauges: counts per gram varies a few percent
    # between printers (it only scales the trigger force), the tare just sets
    # the gram readout; the probe tares itself before every measurement.
    # The tare is one value per gauge, in the order of dout_pins.
    "load_cell_probe": (("counts_per_gram", "116.71463"),
                        ("reference_tare_counts",
                         "422186, 422186, 422185, 422185")),
}
# Strain gauges under the K1 bed (dout_pins in k1os_kalico.cfg)
LOAD_CELL_CHANNELS = 4


def sections(text):
    """Yield (name or None, lines) blocks, keeping order and comments."""
    name, buf = None, []
    for line in text.splitlines(keepends=True):
        m = re.match(r"\[([^\]]+)\]", line)
        if m and not line.startswith("#*#"):
            yield name, buf
            name, buf = m.group(1).strip(), [line]
        else:
            buf.append(line)
    yield name, buf


def rewrite_printer_cfg(path):
    text = open(path).read()
    main, save = text, ""
    if "#*# <---------------------- SAVE_CONFIG ---------------------->" in text:
        i = text.index("#*# <---------------------- SAVE_CONFIG ---------------------->")
        main, save = text[:i], text[i:]
    out = []
    for name, lines in sections(main):
        if name in DROP_SECTIONS:
            continue
        if name == "stepper_z":
            new = []
            for l in lines:
                k = l.split(":")[0].strip()
                if k == "endstop_pin":
                    l = "endstop_pin: probe:z_virtual_endstop\n"
                elif k == "position_endstop":
                    continue
                new.append(l)
            new.insert(1, "homing_retract_dist: 0\nhoming_speed: 3.0\n")
            lines = new
        if name == "printer":
            lines = [l for l in lines if l.split(":")[0].strip()
                     not in ("square_corner_max_velocity", "max_accel_to_decel")]
        out.extend(lines)
    body = "".join(out)
    if "[include k1os_kalico.cfg]" not in body:
        body = "[include k1os_kalico.cfg]\n" + body
    # SAVE_CONFIG: keep PID results, drop meshes and probe data made by prtouch
    keep, skip = [], False
    for l in save.splitlines(keepends=True):
        m = re.match(r"#\*# \[([^\]]+)\]", l)
        if m:
            skip = m.group(1).startswith(DROP_SAVE_CONFIG_SECTIONS)
        if not skip:
            keep.append(l)
    have = {m.group(1) for m in re.finditer(r"^#\*# \[([^\]]+)\]", "".join(keep), re.M)}
    if not keep:
        keep.append(SAVE_CONFIG_HEADER)
    while keep and keep[-1].strip() == "#*#":
        keep.pop()
    for sec, opts in SEED_SAVE_CONFIG.items():
        if sec not in have:
            keep.append("#*#\n#*# [%s]\n" % sec + "".join("#*# %s = %s\n" % kv for kv in opts))
    open(path, "w").write(body + "".join(keep))


def drop_sections_in(path):
    """Remove Creality-only sections from an included config file."""
    text = open(path).read()
    out = []
    for name, lines in sections(text):
        if name in DROP_SECTIONS:
            continue
        out.extend(lines)
    open(path, "w").write("".join(out))


def sub_file(path, pairs):
    if not os.path.exists(path):
        return
    s = open(path).read()
    for a, b in pairs:
        s = re.sub(a, b, s, flags=re.M)
    open(path, "w").write(s)


def split_tare(path):
    """Rewrite a saved tare that is one sum into one value per gauge.

    Kalico used to save the sum of all gauges and now refuses to start unless
    it finds a value for each. Only the sum was ever stored, so it is divided
    evenly: the total, which the gram readout and the drift check use, stays
    exact, and LOAD_CELL_CALIBRATE replaces the shares with measured ones.
    """
    if not os.path.exists(path):
        return
    text = open(path).read()
    done = []

    def split(m):
        total = int(m.group(2))
        share, rest = divmod(total, LOAD_CELL_CHANNELS)
        parts = [share + (i < rest) for i in range(LOAD_CELL_CHANNELS)]
        done.append(total)
        return m.group(1) + ", ".join("%d" % v for v in parts)

    new = re.sub(r"^(#\*# \[load_cell_probe\]\n(?:#\*# (?!\[).*\n)*?"
                 r"#\*# reference_tare_counts = )(-?\d+)[ \t]*$",
                 split, text, flags=re.M)
    if not done:
        return
    shutil.copy(path, path + ".single-tare")
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(new)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)
    print("k1os-kalico-config: load cell tare %d split over %d gauges, "
          "previous file in %s.single-tare" % (done[0], LOAD_CELL_CHANNELS, path))


def main():
    if os.path.exists(MARK):
        split_tare(os.path.join(CFG, "printer.cfg"))
        return 0
    if not os.path.exists(os.path.join(CFG, "printer.cfg")):
        print("k1os-kalico-config: no printer.cfg yet", file=sys.stderr)
        return 1
    bak = CFG + ".creality-" + __import__("time").strftime("%Y%m%d-%H%M%S")
    shutil.copytree(CFG, bak)
    rewrite_printer_cfg(os.path.join(CFG, "printer.cfg"))
    shutil.copy(FRAG, os.path.join(CFG, "k1os_kalico.cfg"))
    macro_pairs = [
        (r"printer\.custom_macro\.", "printer['gcode_macro _K1OS_PARAMS']."),
        (r"printer\.print_stats\.z_pos\|float", "printer.toolhead.position.z|float"),
        (r"printer\.print_stats\.power_loss == 1", "False"),
        (r"^(\s*)BED_MESH_PROFILE LOAD=default_new\s*$", r"\1_KALICO_BED_MESH"),
        (r"^(\s*)BED_MESH_PROFILE LOAD=\"?default\"?\s*$", r"\1"),
        # K1 fans: fan0 part cooling, fan1 chamber (rear), fan2 auxiliary (side).
        # Orca sends the exhaust fan as M106/M107 P3, which Creality's macro
        # folds onto fan0 (the part fan); route it to the chamber fan instead.
        (r"^(\s*)\{% set tmp = params\.P\|int %\}\s*$",
         r"\1{% set tmp = params.P|int %}\n\1{% if tmp == 3 %}{% set tmp = 1 %}{% endif %}"),
        (r"params\.P\|int < fans", "(1 if params.P|int == 3 else params.P|int) < fans"),
        (r"fan\{params\.P\|int\}", "fan{1 if params.P|int == 3 else params.P|int}"),
    ]
    sub_file(os.path.join(CFG, "gcode_macro.cfg"), [(a, b) for a, b in macro_pairs])
    sub_file(os.path.join(CFG, "sensorless.cfg"), [(a, b) for a, b in macro_pairs])
    for f in os.listdir(CFG):
        if f.endswith(".cfg") and f not in ("printer.cfg", "k1os_kalico.cfg") and not f.startswith("printer-"):
            drop_sections_in(os.path.join(CFG, f))
            sub_file(os.path.join(CFG, f), [(r"printer\.custom_macro\.", "printer['gcode_macro _K1OS_PARAMS'].")])
    open(MARK, "w").write(bak + "\n")
    print("k1os-kalico-config: converted, backup in " + bak)
    return 0


if __name__ == "__main__":
    sys.exit(main())
