#!/bin/sh
# ffmpeg stand-in for moonraker-timelapse (its ffmpeg_binary_path points here);
# there is no ffmpeg on the printer. The component renders with
#   ffmpeg -r FPS -i 'DIR/frame%6d.jpg' [-vf '...'] -threads 2 -g 5 -crf N
#          -vcodec libx264 -pix_fmt yuv420p -an [extra] 'OUT.mp4' -y
# Here the frames go through k1os-helix-enc (JPEG decode with libjpeg, H.264
# encode on the X2000 Helix codec) and h264-to-mp4 wraps the stream into the
# MP4 file; no H.264 is encoded on the CPU. The hardware path cannot rotate or
# flip; such filters are reported and ignored. For the same filters the
# component calls a second time, without -vcodec libx264, to turn the preview
# image: that call is answered with success and the image stays as it is.
#
# Quality: the CRF from the Timelapse settings in Mainsail becomes the fixed
# quantiser of the encoder (QP = CRF + 5, so the default CRF 23 gives QP 28,
# about 2 to 4 Mbit/s at 720p30). /usr/data/k1os/timelapse.env may set
# HELIX_QP (18..51) to override it, HELIX_GOP (keyframe interval, 30),
# HELIX_JPEG=1 to decode the JPEGs on the Helix too (10 ms a frame instead of
# 49 ms in software; off by default because its first job once stopped the SoC)
# and HELIX_PROGRESS=1 for a progress bar along the bottom of the video (frame
# N of all frames, so the print's progress); for tests also MP4, ENC and
# HELIX_DEV (the codec's V4L2 node).

# Moonraker starts this and hands down its protection from the OOM killer;
# a render is the kind of thing that should go before the print does.
echo 500 > /proc/$$/oom_score_adj 2>/dev/null
[ -r /usr/data/k1os/timelapse.env ] && . /usr/data/k1os/timelapse.env
MP4=${MP4:-/usr/bin/h264-to-mp4}
ENC=${ENC:-/usr/bin/k1os-helix-enc}
HELIX_DEV=${HELIX_DEV:-/dev/video1}
decflag=
[ "${HELIX_JPEG:-0}" = 1 ] && decflag=-H
progress=
[ "${HELIX_PROGRESS:-0}" = 1 ] && progress=1

fps=30 input= out= vcodec= crf=23 vf=
while [ $# -gt 0 ]; do
    case "$1" in
        -r|-framerate) fps=$2; shift ;;
        -i) input=$2; shift ;;
        -vcodec|-c:v) vcodec=$2; shift ;;
        -crf) crf=$2; shift ;;
        -vf) vf=$2; shift ;;
        -threads|-g|-pix_fmt|-f) shift ;;
        -y|-an) ;;
        -*) ;;
        *) out=$1 ;;
    esac
    shift
done

if [ "$vcodec" != "libx264" ] || [ -z "$input" ] || [ -z "$out" ]; then
    echo "k1os-timelapse-render: only renders videos; left as it is: ${out:-$input}"
    exit 0
fi

dir=$(dirname "$input")
qp=${HELIX_QP:-$((crf + 5))}
[ "$qp" -lt 18 ] && qp=18
[ "$qp" -gt 51 ] && qp=51
h264="${out%.mp4}.h264"
[ -n "$vf" ] && echo "k1os-timelapse-render: the hardware encoder ignores the filter '$vf'"
progflag=
[ -n "$progress" ] && progflag="-p $(ls "$dir"/frame*.jpg 2>/dev/null | wc -l)"

# Progress lines (frame=N ...) go to stdout, where moonraker-timelapse reads them.
# The raw H.264 carries no timestamps; h264-to-mp4 gives every picture the
# same duration, 1/fps.
fps=${fps%.*}
if ls "$dir"/frame*.jpg 2>/dev/null | sort | "$ENC" -d "$HELIX_DEV" $decflag $progflag -q "$qp" -g "${HELIX_GOP:-30}" -o "$h264" - 2>&1 &&
   "$MP4" "${fps:-30}" "$h264" "$out"; then
    rm -f "$h264"
    exit 0
fi
rm -f "$h264" "$out"
echo "k1os-timelapse-render: rendering failed; the frames are still in $dir"
exit 1
