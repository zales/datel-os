[Unit]
Description=Camera MJPEG stream (uStreamer on port 8080)
After=network.target

[Service]
Type=simple
# Optional overrides: CAMERA_RESOLUTION=1920x1080, CAMERA_FPS=30
EnvironmentFile=-/usr/data/k1os/camera.env
ExecStart=/usr/libexec/k1os/camera-stream
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
