#!/bin/sh
# Start uStreamer on the USB camera. The camera delivers MJPEG itself, so
# --encoder=HW passes it through unchanged and the CPU stays idle.
# The frames are also published in the shared-memory sink "k1os::jpeg", from
# which k1os-stream (the Twitch stream) takes them: a UVC node streams to one
# process only, so this is how the camera serves Mainsail and Twitch at once.
dev=$(/usr/libexec/k1os/camera-device) || exit 1
exec /usr/bin/ustreamer --device="$dev" --format=MJPEG --encoder=HW \
    --resolution="${CAMERA_RESOLUTION:-1280x720}" --desired-fps="${CAMERA_FPS:-8}" \
    --drop-same-frames=15 --host=127.0.0.1 --port=8080 --tcp-nodelay --allow-origin='*' \
    --sink=k1os::jpeg --sink-mode=0660 --sink-rm
