#!/bin/sh
# Prepare the Datel OS namespace on the shared /usr/data partition.
# Datel OS writes only below /usr/data/k1os; the stock firmware's files stay untouched.
set -e
D=/usr/data/k1os
mkdir -p $D/printer_data/config $D/printer_data/logs $D/printer_data/database \
         $D/printer_data/gcodes $D/printer_data/comms $D/creality/userdata/config \
         $D/klipper/pres_data $D/guppyscreen

# First boot: start from the printer's own stock Klipper config.
if [ ! -e $D/printer_data/config/printer.cfg ] && [ -e /usr/data/printer_data/config/printer.cfg ]; then
    for f in /usr/data/printer_data/config/*.cfg; do
        case "$(basename "$f")" in printer-[0-9]*_[0-9]*.cfg) continue ;; esac
        cp "$f" $D/printer_data/config/
    done
    echo "k1os: seeded Klipper config from the stock firmware"
fi
[ -e $D/printer_data/config/moonraker.conf ] || cp /etc/k1os/moonraker.conf $D/printer_data/config/
# Moonraker config fragments shipped by packages (/etc/k1os/moonraker.d, e.g.
# [timelapse]) are appended once, when the user's moonraker.conf lacks the section.
for f in /etc/k1os/moonraker.d/*.conf; do
    [ -e "$f" ] || continue
    sec=$(sed -n 's/^\[\([^]]*\)\].*/\1/p' "$f" | head -n 1)
    [ -n "$sec" ] || continue
    if ! grep -q "^\[$sec\]" $D/printer_data/config/moonraker.conf; then
        printf '\n' >> $D/printer_data/config/moonraker.conf
        cat "$f" >> $D/printer_data/config/moonraker.conf
        echo "k1os: added [$sec] to moonraker.conf"
    fi
done

# Print files are shared with the stock slot.
if [ -d /usr/data/printer_data/gcodes ] && [ ! -L $D/printer_data/gcodes ] && [ -z "$(ls -A $D/printer_data/gcodes)" ]; then
    rmdir $D/printer_data/gcodes && ln -s /usr/data/printer_data/gcodes $D/printer_data/gcodes
fi

# Creality's Klipper keeps runtime state in /usr/data/creality/userdata/config.
# Give Datel OS its own copy so stock's power-loss recovery files are not touched.
mkdir -p /usr/data/creality
mountpoint -q /usr/data/creality || mount --bind $D/creality /usr/data/creality

# GuppyScreen keeps its config and theme list next to guppyconfig.json.
mkdir -p $D/guppyscreen $D/printer_data/thumbnails
[ -e $D/guppyscreen/guppyconfig.json ] || cp /etc/k1os/guppyconfig.json $D/guppyscreen/ 2>/dev/null || true
# Creality's Klipper reads its user settings (delay photography, power loss,
# ...) from /usr/data/creality/userdata/config. Datel OS bind-mounts its own copy
# there, so seed it once from the stock files, which sit under the mount.
if [ ! -e $D/creality/userdata/config/.seeded ]; then
    mkdir -p $D/creality/userdata/config /run/k1os-stockdata
    if mount --bind /usr/data /run/k1os-stockdata 2>/dev/null; then
        [ -d /run/k1os-stockdata/creality/userdata/config ] && cp -rn /run/k1os-stockdata/creality/userdata/config/. $D/creality/userdata/config/
        umount /run/k1os-stockdata
    fi
    rmdir /run/k1os-stockdata 2>/dev/null
    touch $D/creality/userdata/config/.seeded
fi

# Themes must be real, writable files: Guppy Screen opens the selected theme
# read-write and writes it back, and that open fails on the read-only root.
[ -L $D/guppyscreen/themes ] && rm -f $D/guppyscreen/themes
mkdir -p $D/guppyscreen/themes
for t in /usr/share/guppyscreen/themes/*.json; do
    [ -e "$D/guppyscreen/themes/$(basename "$t")" ] || cp "$t" "$D/guppyscreen/themes/"
done

# Mainsail's theme: the Datel OS logo and favicon, once; the user may change them.
if [ ! -d $D/printer_data/config/.theme ] && [ -d /usr/share/datel/theme ]; then
    mkdir -p $D/printer_data/config/.theme
    cp /usr/share/datel/theme/* $D/printer_data/config/.theme/
fi

# Wi-Fi: start from the network the stock firmware already knows.
if [ ! -e $D/wpa_supplicant.conf ]; then
    if [ -e /usr/data/wpa_supplicant.conf ]; then
        cp /usr/data/wpa_supplicant.conf $D/wpa_supplicant.conf
    else
        printf 'ctrl_interface=/var/run/wpa_supplicant\nupdate_config=1\n' > $D/wpa_supplicant.conf
    fi
fi
grep -q '^ctrl_interface=' $D/wpa_supplicant.conf || sed -i '1i ctrl_interface=/var/run/wpa_supplicant' $D/wpa_supplicant.conf

# SSH: persistent host keys; log in with keys from /usr/data/k1os/ssh/authorized_keys.
mkdir -p $D/ssh && chmod 700 $D/ssh
[ -e $D/ssh/ssh_host_ed25519_key ] || ssh-keygen -q -t ed25519 -N "" -f $D/ssh/ssh_host_ed25519_key
[ -e $D/ssh/ssh_host_ecdsa_key ] || ssh-keygen -q -t ecdsa -N "" -f $D/ssh/ssh_host_ecdsa_key
touch $D/ssh/authorized_keys && chmod 600 $D/ssh/authorized_keys

# Keep the early MCU update log from this boot.
if [ -e /run/k1os/mcu-update.log ]; then
    mkdir -p $D/log && cat /run/k1os/mcu-update.log >> $D/log/mcu-update.log
fi
