[Unit]
Description=K1 OS: save this boot's journal and failed units to /usr/data/k1os/log
Requires=usr-data.mount
After=usr-data.mount

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'd=/usr/data/k1os/log; mkdir -p $d; { echo "== $(date) uptime $(cut -d" " -f1 /proc/uptime)s"; systemctl --no-pager --failed; echo; systemctl --no-pager list-units --state=activating; echo; journalctl -b --no-pager -o short-monotonic; } > $d/journal-last.txt.tmp 2>&1 && mv $d/journal-last.txt.tmp $d/journal-last.txt'
