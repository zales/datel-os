[Unit]
Description=Datel OS: save the boot journal 30 s and 5 min after boot

# Only the start of a boot is saved: that is the part that is lost when the
# system hangs before the network is up. Later on the journal goes to the log
# server (k1os-logstream) and k1os-trace keeps the minutes before a shutdown.
# Saving the whole journal every minute cost seconds of CPU on a long-running
# printer and rewrote the file on the eMMC each time.
[Timer]
OnBootSec=30s
OnBootSec=5min
AccuracySec=5s

[Install]
WantedBy=timers.target
