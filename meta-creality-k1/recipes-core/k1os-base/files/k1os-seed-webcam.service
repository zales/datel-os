[Unit]
Description=Datel OS: register the camera in Moonraker once
Requires=usr-data.mount
After=usr-data.mount moonraker.service
# Runs while any of its one-time steps has no marker yet.
ConditionPathExists=|!/usr/data/k1os/webcam-seeded
ConditionPathExists=|!/usr/data/k1os/webcam-seeded-webrtc

[Service]
Type=oneshot
ExecStart=/usr/libexec/k1os/seed-webcam

[Install]
WantedBy=multi-user.target
