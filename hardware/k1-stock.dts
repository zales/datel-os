				ingenic,li-port = <0x00 0x01 0x02 0x03 0x04 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c>;
				ingenic,lo-port = <0x00 0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b>;
				ingenic,cap-dai-bm = <0x3e0>;
				ingenic,num-dais = <0x0a>;
			};

			as-baic {
				compatible = "ingenic,as-baic";
				reg = <0x134d5000 0x5000>;
				ingenic,num-dais = <0x05>;
				ingenic,dai-array = <0x00 0x01 0x02 0x03 0x04>;
				ingenic,dai-mode = <0x73f 0x73f 0xfcf 0x17cf 0x73f>;
				ingenic,data-pin-num = <0x01 0x01 0x04 0x04 0x01>;
				ingenic,clk-split = <0x01 0x01 0x01 0x01 0x00>;
				ingenic,clk-rname = "div_i2s0", "div_i2s0", "div_i2s2", "no_clk", "mux_pcm";
				ingenic,clk-tname = "div_i2s1", "div_i2s1", "no_clk", "div_i2s3", "mux_pcm";
				ingenic,pcm-clk-parent = "div_i2s2";
			};

			as-dmic {
				compatible = "ingenic,as-dmic";
				reg = <0x134da000 0x10>;
				ingenic,clk-name = "mux_dmic";
				ingenic,clk-parent = "ext";
			};

			as-mixer {
				compatible = "ingenic,as-mixer";
				reg = <0x134dc000 0x08>;
				ingenic,num-mixers = <0x01>;
			};

			as-spdif {
				compatible = "ingenic,as-spdif";
				reg = <0x134db000 0x14 0x134db100 0x14>;
				reg-names = "out", "in";
				ingenic,clk-name = "mux_spdif";
				ingenic,clk-parent = "div_i2s2";
			};
		};

		msc@0x13450000 {
			compatible = "ingenic,sdhci";
			reg = <0x13450000 0x10000>;
			status = "okay";
			interrupt-parent = <0x04>;
			interrupts = <0x25>;
			pinctrl-names = "default";
			pinctrl-0 = <0x12>;
			mmc-hs200-1_8v;
			cap-mmc-highspeed;
			non-removable;
			max-frequency = <0x5f5e100>;
			bus-width = <0x08>;
			voltage-ranges = <0x708 0xce4>;
			ingenic,wp-gpios = <0x00>;
			ingneic,cd-gpios = <0x00>;
			ingenic,rst-gpios = <0x00>;
		};

		msc@0x13460000 {
			compatible = "ingenic,sdhci";
			reg = <0x13460000 0x10000>;
			status = "disabled";
			interrupt-parent = <0x04>;
			interrupts = <0x24>;
		};

		msc@0x13490000 {
			compatible = "ingenic,sdhci";
			reg = <0x13490000 0x10000>;
			status = "disabled";
			interrupt-parent = <0x04>;
			interrupts = <0x30>;
		};

		aes@0x13430000 {
			compatible = "ingenic,aes";
			reg = <0x13430000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x17>;
			status = "ok";
		};

		hash@0x13470000 {
			compatible = "ingenic,hash";
			reg = <0x13470000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x16>;
			status = "ok";
		};

		rsa@0x13480000 {
			compatible = "ingenic,rsa";
			reg = <0x13480000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x18>;
			status = "ok";
		};

		mac@0x134b0000 {
			compatible = "ingenic,x2000-mac";
			reg = <0x134b0000 0x2000>;
			interrupt-parent = <0x04>;
			interrupts = <0x37>;
			status = "disabled";
			ingenic,rst-ms = <0x0a>;
		};

		mac@0x134a0000 {
			compatible = "ingenic,x2000-mac";
			reg = <0x134a0000 0x2000>;
			interrupt-parent = <0x04>;
			interrupts = <0x35>;
			status = "disabled";
			ingenic,rst-ms = <0x0a>;
		};

		sfc@0x13440000 {
			compatible = "ingenic,x2000-sfc";
			reg = <0x13440000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x07>;
		};

		dma@0x13420000 {
			compatible = "ingenic,x2000-pdma";
			reg = <0x13420000 0x10000>;
			interrupt-parent = <0x04>;
			interrupt-names = "pdma", "pdmad";
			interrupts = <0x03 0x04>;
			#dma-channels = <0x20>;
			#dma-cells = <0x01>;
			ingenic,reserved-chs = <0x03>;
			status = "okay";
			linux,phandle = <0x11>;
			phandle = <0x11>;
		};

		mcu@0x13420000 {
			compatible = "ingenic,x2000-mcu";
			reg = <0x13420000 0x10000>;
			interrupt-parent = <0x04>;
			interrupt-names = "pdmam";
			interrupts = <0x05>;
			ingenic,tcsm_size = <0x4000>;
		};

		pwm@0x134c0000 {
			compatible = "ingenic,x2000-pwm";
			#pwm-cells = <0x02>;
			reg = <0x134c0000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x06>;
		};

		otg@0x13500000 {
			compatible = "ingenic,dwc2-hsotg";
			reg = <0x13500000 0x40000>;
			interrupt-parent = <0x04>;
			interrupts = <0x01>;
			clocks = <0x05 0x58>;
			clock-names = "gate_otg";
			ingenic,usbphy = <0x13>;
			status = "okay";
			dr_mode = "otg";
		};

		otg_new@0x13500000 {
			compatible = "ingenic,x2000-dwc2-hsotg";
			reg = <0x13500000 0x40000>;
			interrupt-parent = <0x04>;
			interrupts = <0x01>;
			ingenic,usbphy = <0x14>;
			dr_mode = "otg";
			g-rx-fifo-size = <0x448>;
			g-np-tx-fifo-size = <0x200>;
			g-tx-fifo-size = <0x10 0x10 0x10 0x80 0x100 0x100 0x200 0x300>;
			status = "okay";
		};

		efuse@0x13540000 {
			compatible = "ingenic,x2000-efuse";
			reg = <0x13540000 0x10000>;
			status = "okay";
		};
	};

	ahb1 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;
	};

	ahb0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		cim@0x13060000 {
			compatible = "ingenic,x2000-cim";
			reg = <0x13060000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x1e>;
			clocks = <0x05 0x30 0x05 0x45 0x05 0x5e>;
			clock-names = "div_cim", "gate_cim", "gate_mipi";
			status = "disable";
		};

		isp-camera@0 {
			compatible = "ingenic,x2000-isp-camera";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;

			port {

				endpoint@0 {
				};
			};

			csi@0x10074000 {
				compatible = "ingenic,x2000-csi";
				reg = <0x10074000 0x1000>;
				interrupt-parent = <0x04>;
				interrupts = <0x0c>;
				clocks = <0x05 0x5e>;
				clock-names = "gate_csi";
			};

			vic@0x13710000 {
				compatible = "ingenic,x2000-vic";
				reg = <0x13710000 0x10000>;
				interrupt-parent = <0x04>;
				interrupts = <0x13>;
				status = "ok";
			};

			isp@0x13700000 {
				compatible = "ingenic,x2000-isp";
				reg = <0x13700000 0x2300>;
				interrupt-parent = <0x04>;
				interrupts = <0x15>;
				clocks = <0x05 0x32 0x05 0x76 0x05 0x7e>;
				clock-names = "div_isp", "gate_isp0", "power_isp0";
				status = "ok";
				ingenic,cpm_reset = <0xb00000c4>;
				ingenic,bit_sr = <0x19>;
				ingenic,bit_stp = <0x18>;
				ingenic,bit_ack = <0x17>;
			};

			mscaler@0x13702300 {
				compatible = "ingenic,x2000-mscaler";
				reg = <0x13702300 0x400>;
				status = "ok";
			};
		};

		isp-camera@1 {
			compatible = "ingenic,x2000-isp-camera";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;

			port {

				endpoint@0 {
				};
			};

			csi@0x10073000 {
				compatible = "ingenic,x2000-csi";
				reg = <0x10073000 0x1000>;
				interrupt-parent = <0x04>;
				interrupts = <0x1c>;
				clocks = <0x05 0x5e>;
				clock-names = "gate_csi";
			};

			vic@0x13810000 {
				compatible = "ingenic,x2000-vic";
				reg = <0x13810000 0x10000>;
				interrupt-parent = <0x04>;
				interrupts = <0x12>;
				status = "ok";
			};

			isp@0x13800000 {
				compatible = "ingenic,x2000-isp";
				reg = <0x13800000 0x2300>;
				interrupt-parent = <0x04>;
				interrupts = <0x14>;
				clocks = <0x05 0x32 0x05 0x75 0x05 0x7f>;
				clock-names = "div_isp", "gate_isp1", "power_isp1";
				status = "ok";
				ingenic,cpm_reset = <0xb00000c4>;
				ingenic,bit_sr = <0x16>;
				ingenic,bit_stp = <0x15>;
				ingenic,bit_ack = <0x14>;
			};

			mscaler@0x13802300 {
				compatible = "ingenic,x2000-mscaler";
				reg = <0x13802300 0x400>;
				status = "ok";
			};
		};

		dpu@0x13050000 {
			compatible = "ingenic,x2000-dpu";
			reg = <0x13050000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x1f>;
			status = "disabled";
		};

		rotate@0x13070000 {
			compatible = "ingenic,x2000-rotate";
			reg = <0x13070000 0x10000>;
			interrupt-parent = <0x04>;
			interrupts = <0x1d>;
			status = "okay";
		};

		helix@0x13200000 {
			compatible = "ingenic,x2000-helix";
			reg = <0x13200000 0x100000>;
			interrupt-parent = <0x04>;
			interrupts = <0x3e>;
			status = "okay";
			memory-region = <0x15>;
		};

		felix@0x13300000 {
			compatible = "ingenic,x2000-felix";
			reg = <0x13300000 0x100000>;
			interrupt-parent = <0x04>;
			interrupts = <0x3f>;
			status = "okay";
			memory-region = <0x15>;
		};
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		reserved_mem@0x5000000 {
			compatible = "shared-dma-pool";
			reg = <0x5000000 0x2400000>;
			linux,phandle = <0x15>;
			phandle = <0x15>;
		};
	};

	md_rmem {
		status = "okay";
		compatible = "ingenic,md-rmem-src";
		memory-region = <0x15>;
	};

	swd {
		compatible = "creality,swd";
		status = "okay";
		swdio-gpio = <0x08 0x0a 0x00 0x00>;
		swclk-gpio = <0x08 0x06 0x00 0x00>;
		nrst-gpio = <0x08 0x07 0x01 0x00>;
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		sys_led {
			label = "sys-led";
			gpios = <0x08 0x0d 0x01 0x00>;
			linux,default-trigger = "timer";
		};
	};
};
