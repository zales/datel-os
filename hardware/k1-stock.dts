/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	compatible = "ingenic,x2000_module_base", "ingenic,x2000";

	aliases {
		i2c0 = "/apb/i2c@0x10050000";
		i2c1 = "/apb/i2c@0x10051000";
		i2c2 = "/apb/i2c@0x10052000";
		i2c3 = "/apb/i2c@0x10053000";
		i2c4 = "/apb/i2c@0x10054000";
		i2c5 = "/apb/i2c@0x10055000";
		uart0 = "/apb/serial@0x10030000";
		uart1 = "/apb/serial@0x10031000";
		uart2 = "/apb/serial@0x10032000";
		uart3 = "/apb/serial@0x10033000";
		uart4 = "/apb/serial@0x10034000";
		uart5 = "/apb/serial@0x10035000";
		uart6 = "/apb/serial@0x10036000";
		uart7 = "/apb/serial@0x10037000";
		uart8 = "/apb/serial@0x10038000";
		uart9 = "/apb/serial@0x10039000";
		mmc0 = "/ahb2/msc@0x13450000";
		mmc1 = "/ahb2/msc@0x13460000";
		mmc2 = "/ahb2/msc@0x13490000";
		mac0 = "/ahb2/mac@0x134b0000";
		mac1 = "/ahb2/mac@0x134a0000";
		spi0 = "/apb/spi0@0x10043000";
		spi1 = "/apb/spi1@0x10044000";
		pwm = "/ahb2/pwm@0x134c0000";
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "ingenic,xburst2";
			reg = <0x00>;
			clock-frequency = <0x2faf0800>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "ingenic,xburst2";
			reg = <0x01>;
			clock-frequency = <0x2faf0800>;
		};
	};

	cpufreq-dt {
		compatible = "ingenic,x2000-cpufreq";
		status = "okay";
		operating-points = <0x124f80 0xdbba0 0xb71b0 0xdbba0 0x927c0 0xdbba0 0x7a120 0xdbba0 0x61a80 0xdbba0 0x5b8d8 0xdbba0 0x493e0 0xdbba0 0x30d40 0xdbba0>;
	};

	interrupt-controller {
		#address-cells = <0x00>;
		#interrupt-cells = <0x01>;
		interrupt-controller;
		compatible = "ingenic,cpu-interrupt-controller";
		linux,phandle = <0x01>;
		phandle = <0x01>;
	};

	core-intc@0x12300000 {
		compatible = "ingenic,core-intc";
		reg = <0x12300000 0x1000 0x10001000 0x1000>;
		interrupt-controller;
		#interrupt-cells = <0x01>;
		cpu-intc-map = <0x00 0x00 0x01 0x100 0x02 0x200 0x03 0x300>;
		interrupt-parent = <0x01>;
		interrupts = <0x02>;
		interrupt-names = "intc";
		linux,phandle = <0x04>;
		phandle = <0x04>;
	};

	core-ost@0x12000000 {
		compatible = "ingenic,core-ost";
		reg = <0x12000000 0x10000 0x12100000 0x10000>;
		interrupt-parent = <0x01>;
		interrupt-names = "sys_ost";
		interrupts = <0x04>;
		cpu-ost-map = <0x00 0x00 0x01 0x100>;
	};

	extclk {
		compatible = "ingenic,fixed-clock";
		clock-output-names = "ext";
		#clock-cells = <0x00>;
		clock-frequency = <0x16e3600>;
		linux,phandle = <0x02>;
		phandle = <0x02>;
	};

	rtcclk {
		compatible = "ingenic,fixed-clock";
		clock-output-names = "rtc_ext";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		linux,phandle = <0x03>;
		phandle = <0x03>;
	};

	pm {
		compatible = "ingenic,x2000-pm";
		status = "okay";
	};

	apb {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		clock-controller@0x10000000 {
			compatible = "ingenic,x2000-clocks";
			reg = <0x10000000 0x100>;
			clocks = <0x02 0x03>;
			clock-names = "ext", "rtc_ext";
			#clock-cells = <0x01>;
			little-endian;
			linux,phandle = <0x05>;
			phandle = <0x05>;
		};

		sadc@10070000 {
			compatible = "ingenic,x2000-sadc";
			reg = <0x10070000 0x32>;
			interrupt-parent = <0x04>;
			interrupts = <0x0b>;
			interrupt-controller;
			status = "ok";
		};

		tcu@0x10002000 {
			compatible = "ingenic,tcu";
			reg = <0x10002000 0x1000>;
			interrupt-parent = <0x04>;
			interrupt-names = "default";
			interrupts = <0x1b>;
			clocks = <0x05 0x49>;
			clock-names = "gate_tcu";
			status = "ok";
		};

		watchdog@0x10002000 {
			compatible = "ingenic,watchdog";
			reg = <0x10002000 0x40>;
			interrupt-parent = <0x04>;
			interrupts = <0x1b>;
			status = "ok";
		};

		rtc@0x10003000 {
			compatible = "ingenic,rtc";
			reg = <0x10003000 0x4c>;
			interrupt-parent = <0x04>;
			interrupts = <0x20>;
			system-power-controller;
			power-on-press-ms = <0x3e8>;
			status = "ok";
		};

		pinctrl@0x10010000 {
			compatible = "ingenic,x2000-pinctrl";
			reg = <0x10010000 0x1000>;
			ingenic,num-chips = <0x05>;
			ingenic,regs-offset = <0x100>;
			ingenic,gpa_voltage = <0x02>;
			ingenic,gpe_msc_voltage = <0x01>;

			gpa {
				gpio-controller;
				#gpio-cells = <0x03>;
				#ingenic,pincfg-cells = <0x03>;
				#ingenic,pinmux-cells = <0x02>;
				interrupts = <0x11>;
				interrupt-parent = <0x04>;
				interrupt-controller;
				#interrupt-cells = <0x03>;
				ingenic,num-gpios = <0x20>;
				linux,phandle = <0x08>;
				phandle = <0x08>;
			};

			gpb {
				gpio-controller;
				#gpio-cells = <0x03>;
				#ingenic,pincfg-cells = <0x03>;
				#ingenic,pinmux-cells = <0x02>;
				interrupts = <0x10>;
				interrupt-parent = <0x04>;
				interrupt-controller;
				#interrupt-cells = <0x03>;
				ingenic,num-gpios = <0x20>;
				linux,phandle = <0x09>;
				phandle = <0x09>;
			};

			gpc {
				gpio-controller;
				#gpio-cells = <0x03>;
				#ingenic,pincfg-cells = <0x03>;
				#ingenic,pinmux-cells = <0x02>;
				interrupts = <0x0f>;
				interrupt-parent = <0x04>;
				interrupt-controller;
				#interrupt-cells = <0x03>;
				ingenic,num-gpios = <0x20>;
				linux,phandle = <0x07>;
				phandle = <0x07>;
			};

			gpd {
				gpio-controller;
				#gpio-cells = <0x03>;
				#ingenic,pincfg-cells = <0x03>;
				#ingenic,pinmux-cells = <0x02>;
				interrupts = <0x0e>;
				interrupt-parent = <0x04>;
				interrupt-controller;
				#interrupt-cells = <0x03>;
				ingenic,num-gpios = <0x20>;
				linux,phandle = <0x06>;
				phandle = <0x06>;
			};

			gpe {
				gpio-controller;
				#gpio-cells = <0x03>;
				#ingenic,pincfg-cells = <0x03>;
				#ingenic,pinmux-cells = <0x02>;
				interrupts = <0x0d>;
				interrupt-parent = <0x04>;
				interrupt-controller;
				#interrupt-cells = <0x03>;
				ingenic,num-gpios = <0x20>;
				linux,phandle = <0x0a>;
				phandle = <0x0a>;
			};

			uart0-pin {

				uart0-pd {
					ingenic,pinmux = <0x06 0x17 0x1a>;
					ingenic,pinmux-funcsel = <0x02>;
				};
			};

			uart1-pin {

				uart1-pc {
					ingenic,pinmux = <0x07 0x17 0x18>;
					ingenic,pinmux-funcsel = <0x01>;
					linux,phandle = <0x0b>;
					phandle = <0x0b>;
				};
			};

			uart2-pin {

				uart2-pd {
					ingenic,pinmux = <0x06 0x1e 0x1f>;
					ingenic,pinmux-funcsel = <0x00>;
					linux,phandle = <0x0c>;
					phandle = <0x0c>;
				};
			};

			uart3-pin {

				uart3-pc {
					ingenic,pinmux = <0x07 0x19 0x1a>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				uart3-pd {
					ingenic,pinmux = <0x06 0x00 0x03>;
					ingenic,pinmux-funcsel = <0x01>;
					linux,phandle = <0x0d>;
					phandle = <0x0d>;
				};
			};

			uart4-pin {

				uart4-pa {
					ingenic,pinmux = <0x08 0x00 0x03>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				uart4-pc {
					ingenic,pinmux = <0x07 0x09 0x0c>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart5-pin {

				uart5-pa {
					ingenic,pinmux = <0x08 0x04 0x05>;
					ingenic,pinmux-funcsel = <0x01>;
					linux,phandle = <0x0e>;
					phandle = <0x0e>;
				};

				uart5-pc {
					ingenic,pinmux = <0x07 0x05 0x06>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart6-pin {

				uart6-pa {
					ingenic,pinmux = <0x08 0x06 0x07>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				uart6-pc {
					ingenic,pinmux = <0x07 0x07 0x08>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart7-pin {

				uart7-pa {
					ingenic,pinmux = <0x08 0x08 0x09>;
					ingenic,pinmux-funcsel = <0x01>;
					linux,phandle = <0x0f>;
					phandle = <0x0f>;
				};

				uart7-pc {
					ingenic,pinmux = <0x07 0x01 0x02>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart8-pin {

				uart8-pb {
					ingenic,pinmux = <0x09 0x1c 0x1d>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			uart9-pin {

				uart9-pb {
					ingenic,pinmux = <0x09 0x1e 0x1f>;
					ingenic,pinmux-funcsel = <0x03>;
					linux,phandle = <0x10>;
					phandle = <0x10>;
				};
			};

			i2c0-pin {

				i2c0-pc {
					ingenic,pinmux = <0x07 0x0d 0x0e>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			i2c1-pin {

				i2c1-pc {
					ingenic,pinmux = <0x07 0x17 0x18>;
					ingenic,pinmux-funcsel = <0x02>;
				};
			};

			i2c2-pin {

				i2c2-pb {
					ingenic,pinmux = <0x09 0x16 0x17>;
					ingenic,pinmux-funcsel = <0x02>;
				};
			};

			i2c3-pin {

				i2c3-pd {
					ingenic,pinmux = <0x06 0x1e 0x1f>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				i2c3-pa {
					ingenic,pinmux = <0x08 0x10 0x11>;
					ingenic,pinmux-funcsel = <0x00>;
				};
			};

			i2c4-pin {

				i2c4-pc {
					ingenic,pinmux = <0x07 0x19 0x1a>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				i2c4-pd {
					ingenic,pinmux = <0x06 0x00 0x01>;
					ingenic,pinmux-funcsel = <0x02>;
				};
			};

			i2c5-pin {

				i2c5-pc {
					ingenic,pinmux = <0x07 0x1b 0x1c>;
					ingenic,pinmux-funcsel = <0x01>;
				};

				i2c5-pd {
					ingenic,pinmux = <0x06 0x04 0x05>;
					ingenic,pinmux-funcsel = <0x01>;
				};
			};

			msc0-pin {

				msc0-4bit {
					ingenic,pinmux = <0x06 0x11 0x16>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				msc0-8bit {
					ingenic,pinmux = <0x06 0x11 0x1a>;
					ingenic,pinmux-funcsel = <0x00>;
					linux,phandle = <0x12>;
					phandle = <0x12>;
				};
			};

			msc1-pin {

				msc1-4bit {
					ingenic,pinmux = <0x06 0x08 0x0d>;
					ingenic,pinmux-funcsel = <0x00>;
				};
			};

			msc2-pin {

				msc2-4bit {
					ingenic,pinmux = <0x0a 0x00 0x05>;
					ingenic,pinmux-funcsel = <0x00>;
				};
			};

			nemc_pin {

				nemc_pb {
					ingenic,pinmux = <0x09 0x00 0x1f>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				nemc_pc {
					ingenic,pinmux = <0x07 0x17 0x18>;
					ingenic,pinmux-funcsel = <0x03>;
				};
			};

			mac0-phy-clk {
				ingenic,pinmux = <0x07 0x01 0x01>;
				ingenic,pinmux-funcsel = <0x01>;
				ingenic,pincfg = <0x07 0x01 0x01 0x40009>;
			};

			mac0-rmii-p0 {

				mac0-rmii-normal {
					ingenic,pinmux = <0x07 0x06 0x07 0x07 0x0b 0x0b 0x07 0x0f 0x0f>;
					ingenic,pinmux-funcsel = <0x01>;
					ingenic,pincfg = <0x07 0x06 0x07 0x1000b 0x07 0x0b 0x0b 0x1000b 0x07 0x0f 0x0f 0x1000b>;
				};

				mac0-rmii-p0-rst {
					ingenic,pinmux = <0x07 0x06 0x07 0x07 0x0b 0x0b 0x07 0x0f 0x0f>;
					ingenic,pinmux-funcsel = <0x06>;
					ingenic,pincfg = <0x07 0x06 0x07 0x10002 0x07 0x0b 0x0b 0x10002 0x07 0x0f 0x0f 0x10002>;
				};
			};

			mac0-rmii-p1 {

				mac0-rmii-p1-normal {
					ingenic,pinmux = <0x07 0x02 0x03 0x07 0x0a 0x0a 0x07 0x0c 0x0d>;
					ingenic,pinmux-funcsel = <0x01>;
					ingenic,pincfg = <0x07 0x02 0x03 0x40009 0x07 0x0a 0x0a 0x40009 0x07 0x0c 0x0d 0x40009>;
				};

				mac0-rmii-p1-nomdio {
					ingenic,pinmux = <0x07 0x02 0x03 0x07 0x0a 0x0a>;
					ingenic,pinmux-funcsel = <0x01>;
					ingenic,pincfg = <0x07 0x02 0x03 0x40009 0x07 0x0a 0x0a 0x40009>;
				};
			};

			mac0-rgmii-p0 {

				mac0-rgmii-normal {
					ingenic,pinmux = <0x07 0x06 0x09 0x07 0x0b 0x0b 0x07 0x0f 0x0f>;
					ingenic,pinmux-funcsel = <0x01>;
					ingenic,pincfg = <0x07 0x06 0x09 0x1000b 0x07 0x0b 0x0b 0x1000b 0x07 0x0f 0x0f 0x1000b>;
				};

				mac0-rgmii-p0-rst {
					ingenic,pinmux = <0x07 0x06 0x09 0x07 0x0b 0x0b 0x07 0x0f 0x0f>;
					ingenic,pinmux-funcsel = <0x06>;
					ingenic,pincfg = <0x07 0x06 0x09 0x10002 0x07 0x0b 0x0b 0x10002 0x07 0x0f 0x0f 0x10002>;
				};
			};

			mac0-rgmii-p1 {

				mac0-rgmii-p1-normal {
					ingenic,pinmux = <0x07 0x02 0x05 0x07 0x0a 0x0a 0x07 0x0c 0x0e>;
					ingenic,pinmux-funcsel = <0x01>;
					ingenic,pincfg = <0x07 0x02 0x05 0x40009 0x07 0x0a 0x0a 0x40009 0x07 0x0c 0x0e 0x40009>;
				};

				mac0-rgmii-p1-nomdio {
					ingenic,pinmux = <0x07 0x02 0x05 0x07 0x0a 0x0a 0x07 0x0e 0x0e>;
					ingenic,pinmux-funcsel = <0x01>;
					ingenic,pincfg = <0x07 0x02 0x05 0x40009 0x07 0x0a 0x0a 0x40009 0x07 0x0e 0x0e 0x40009>;
				};
			};

			mac1-phy-clk {
				ingenic,pinmux = <0x09 0x17 0x17>;
				ingenic,pinmux-funcsel = <0x03>;
				ingenic,pincfg = <0x07 0x17 0x17 0x40009>;
			};

			mac1-rmii-p0 {

				mac1-rmii-normal {
					ingenic,pinmux = <0x09 0x0c 0x0d 0x09 0x12 0x12 0x09 0x16 0x16>;
					ingenic,pinmux-funcsel = <0x03>;
					ingenic,pincfg = <0x09 0x0c 0x0d 0x1000b 0x09 0x12 0x12 0x1000b 0x09 0x16 0x16 0x1000b>;
				};

				mac1-rmii-p0-rst {
					ingenic,pinmux = <0x09 0x0c 0x0d 0x09 0x12 0x12 0x09 0x16 0x16>;
					ingenic,pinmux-funcsel = <0x06>;
					ingenic,pincfg = <0x09 0x0c 0x0d 0x10002 0x09 0x12 0x12 0x10002 0x09 0x16 0x16 0x10002>;
				};
			};

			mac1-rmii-p1 {

				mac1-rmii-p1-normal {
					ingenic,pinmux = <0x09 0x08 0x09 0x09 0x11 0x11 0x09 0x13 0x14>;
					ingenic,pinmux-funcsel = <0x03>;
					ingenic,pincfg = <0x09 0x08 0x09 0x40009 0x09 0x11 0x11 0x40009 0x09 0x13 0x14 0x40009>;
				};

				mac1-rmii-p1-nomdio {
					ingenic,pinmux = <0x09 0x08 0x09 0x09 0x11 0x11>;
					ingenic,pinmux-funcsel = <0x03>;
					ingenic,pincfg = <0x09 0x08 0x09 0x40009 0x09 0x11 0x11 0x40009>;
				};
			};

			mac1-rgmii-p0 {

				mac1-rgmii-normal {
					ingenic,pinmux = <0x09 0x0c 0x0f 0x09 0x12 0x12 0x09 0x16 0x16>;
					ingenic,pinmux-funcsel = <0x03>;
					ingenic,pincfg = <0x09 0x0c 0x0f 0x1000b 0x09 0x12 0x12 0x1000b 0x09 0x16 0x16 0x1000b>;
				};

				mac1-rgmii-p0-rst {
					ingenic,pinmux = <0x09 0x0c 0x0f 0x09 0x12 0x12 0x09 0x16 0x16>;
					ingenic,pinmux-funcsel = <0x06>;
					ingenic,pincfg = <0x09 0x0c 0x0f 0x10002 0x09 0x12 0x12 0x10002 0x09 0x16 0x16 0x10002>;
				};
			};

			mac1-rgmii-p1 {

				mac1-rgmii-p1-normal {
					ingenic,pinmux = <0x09 0x08 0x0b 0x09 0x11 0x11 0x09 0x13 0x15>;
					ingenic,pinmux-funcsel = <0x03>;
					ingenic,pincfg = <0x09 0x08 0x0b 0x40009 0x09 0x11 0x11 0x40009 0x09 0x13 0x15 0x40009>;
				};

				mac1-rgmii-p1-nomdio {
					ingenic,pinmux = <0x09 0x08 0x0b 0x09 0x11 0x11 0x09 0x15 0x15>;
					ingenic,pinmux-funcsel = <0x03>;
					ingenic,pincfg = <0x09 0x08 0x0b 0x40009 0x09 0x11 0x11 0x40009 0x09 0x15 0x15 0x40009>;
				};
			};

			pwm-pin {

				pwm0_pc {
					ingenic,pinmux = <0x07 0x00 0x00>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm1_pc {
					ingenic,pinmux = <0x07 0x01 0x01>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm2_pc {
					ingenic,pinmux = <0x07 0x02 0x02>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm3_pc {
					ingenic,pinmux = <0x07 0x03 0x03>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm4_pc {
					ingenic,pinmux = <0x07 0x04 0x04>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm5_pc {
					ingenic,pinmux = <0x07 0x05 0x05>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm6_pc {
					ingenic,pinmux = <0x07 0x06 0x06>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm7_pc {
					ingenic,pinmux = <0x07 0x07 0x07>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm8_pc {
					ingenic,pinmux = <0x07 0x08 0x08>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm9_pc {
					ingenic,pinmux = <0x07 0x09 0x09>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm10_pc {
					ingenic,pinmux = <0x07 0x0a 0x0a>;
					ingenic,pinmux-funcsel = <0x00>;
				};

				pwm11_pc {
					ingenic,pinmux = <0x07 0x0b 0x0b>;
